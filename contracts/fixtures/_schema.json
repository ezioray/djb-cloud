{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DJB module fixture",
  "type": "object",
  "required": [
    "module",
    "case",
    "description",
    "input",
    "expect"
  ],
  "properties": {
    "module": {
      "type": "string",
      "pattern": "^M[0-9]{2}$"
    },
    "case": {
      "enum": [
        "success",
        "error",
        "boundary"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "expect": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
